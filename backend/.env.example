# AI_PROVIDER can be 'gemini', 'anthropic', 'openai', or 'mock'.
AI_PROVIDER=gemini

# Google Gemini configuration (required for Gemini Live realtime voice)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EVALUATION_MODEL=gemini-4-hydrogen
GEMINI_EVALUATION_THINKING_LEVEL=medium
GEMINI_REALTIME_MODEL=gemini-3.8-live

# Anthropic (Claude) configuration
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI configuration (required for Realtime WebRTC voice)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

FRONTEND_ORIGINS=http://localhost:5173
ENVIRONMENT=development
RECRUITER_NAME=Iris

# Database configuration (defaults to local SQLite; override DATABASE_URL for PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/interviewer)
DATABASE_PATH=data/interviewer.db

# Access key enforcement (keep false in local dev, set true in public deployments)
REQUIRE_ACCESS_KEY=false
# Secret password required to access /admin and /api/admin/* endpoints (keep private!)
ADMIN_SECRET=
