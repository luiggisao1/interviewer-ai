# AI_PROVIDER can be 'gemini', 'anthropic', 'openai', or 'mock'.
AI_PROVIDER=gemini

# Google Gemini configuration (required for Gemini Live realtime voice)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REALTIME_MODEL=gemini-3.8-flash

# Anthropic (Claude) configuration
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI configuration (required for Realtime WebRTC voice)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

FRONTEND_ORIGINS=http://localhost:5173
ENVIRONMENT=development
RECRUITER_NAME=Iris
